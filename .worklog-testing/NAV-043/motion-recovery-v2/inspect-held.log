execution_alignment_policy {
  "applies_to": "全部67项NAV任务的后续执行、恢复、回修和阶段交接。此全局规则不新增任务，不追改历史记录，不把旧记录缺少本轮对齐字段视为已重新验收。",
  "global_goal_card": {
    "objective": "在Go2仿真中交付与RC-PPO核心原理一致、固定v2的分层最小成本到达避障导航；在预算内安全到达并尽量降低正关节机械功。",
    "principle_to_preserve": "预算增广状态、不可逆安全历史、共同停止时刻、双评价目标、成本/reach/联合三套估计器及联合GAE、最小化PPO和部署价值预算搜索形成同一方法链。",
    "allowed_adaptation": "按Go2环境定制状态/观测、速度输入输出、PyTorch组织和J单位；适配必须保持已确认的数学目标与评分语义，并提供对应证据。",
    "fixed_boundaries": [
      "固定camra_go2_velocity_it2999_v2及整套执行/校准身份，保留其已知局限，不换模型、不改旧功率模型/足迹/α/δ或冻结锁。",
      "物理200 Hz、底层50 Hz、上层10 Hz，机身系[vx,vy,yaw_rate]；内部模型成本和实际正机械功分列，单位J。",
      "执行固定tiger11（192.168.20.11）+tmux；运行前现场核验资源，Windows文档/静态检查例外。",
      "train/development、独立预算选择与final_*用途隔离，历史暴露如实登记，全部失败和原始证据保留，资源不暗中扩额。",
      "RC-PPO/、HiRA/、论文和历史冻结成果保持只读；计划内明确的导航实现缺陷可按回修规则修复。"
    ],
    "success_test": "本项不仅局部可用，还须保持方法目标不变、实际接入生产链、上下游版本一致，并由真实证据支持；负结果按原样记录，不伪装成通过。"
  },
  "mandatory_reading": {
