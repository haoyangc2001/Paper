upstream_correction_policy {
  "applies_to": "全部67项NAV任务；本次原位修订未新增任务，历史记录和状态保留。",
  "user_authorization": "用户同意：后面的工作发现前面的工作有问题时，可以同步纠正；原工作记录必须保留，修正过程在当前任务下记录。",
  "scope_rule": "依据明确、目标不变且在既定代码范围和已登记资源内的实现缺陷，可以在当前任务中回修，无需为普通修复重复申请。此授权不允许更改来源、科学目标、评分、依赖、资源配额或受保护成果；相关不确定决策仍按uncertainty_policy暂停询问。",
  "history_rule": "原work_records、失败、旧判定、原始日志、冻结文件与数据锁不删除、不改写。修正前登记版本/路径/hash并保留可恢复源码或快照；新报告、锁和重跑产物使用独立版本及run/attempt身份，不覆盖旧产物，不以更新旧hash掩盖变更。",
  "record_owner_rule": "问题发现、影响分析、修复动作、用户决定、验证和解除阻塞的主体记录，全部追加在发现问题的当前任务work_records内。保持九个标准记录字段，并以correction子对象关联前置任务；必要时只在相关旧任务追加交叉引用，不搬走或改写当前任务中的主体记录。",
  "workflow": [
    "发现问题后保持当前任务status=false，先追加事实、复现证据和受影响前置任务；暂停依赖该错误结果的后续动作，不以已有true状态或旧门禁继续放行。",
    "定位根因和影响范围，登记原代码/配置/结果的版本与hash，列出受影响任务、门禁、训练模型、数据锁和评估产物；不受影响的历史结论保留。",
    "核对授权边界。在新导航实现内修复确定的错误；若涉及v2冻结系统、旧校准、参考仓库或需改变既定契约/资源，先记录blocker并询问用户。论文禁止写入规则始终有效。",
    "在可恢复的代码版本中修复，追加说明具体改动和新旧差异；不能回填旧日志，把原错误运行改写成修复后的结果。",
    "针对根因及下游影响完成必要重验。优先复用未受影响的有效证据；需要重训、重采或重跑正式试验时先核对授权与预算，不自行无限加跑或覆盖正式数据。",
    "把命令、文件、修正后版本、验证证据、状态变化及下游处理结论追加到当前任务，明确哪些旧结论仅作历史记录、哪些证据仍然适用。",
    "先按依赖恢复受影响的验收与门禁，再继续当前任务本身；只有当前任务全部验收也满足后才能标记true。每轮状态更新后运行update校验。"
  ],
  "correction_record_required_fields": [
    "correction_id：当前任务下唯一的回修编号",
    "discovered_in_task：发现问题的当前任务ID",
    "upstream_task_ids：问题涉及的前置任务ID",
    "problem_and_evidence：问题、根因与可复现证据",
    "original_artifact_references：原版本、文件/hash和历史验收引用",
    "affected_task_ids：受影响的当前及下游任务",
    "affected_gate_ids：需重验的门禁，无则为空数组",
    "authorization_basis：既有授权依据或新增用户决定",
    "changes_and_versions：修复文件、改动及新版本/产物身份",
    "revalidation_evidence：复验命令、结果和证据路径",
    "status_changes：前后status/verification_result及变化依据，无变化则为空数组",
    "downstream_disposition：继续、失效待重验或仍受阻的结论及理由",
    "closure_state：open、blocked或validated"
  ],
  "task_and_gate_state_rules": [
    "发现问题的当前任务在回修和相关重验结束前保持false；不得单凭修复代码已写完就算当前任务完成。",
    "若证据表明前置验收实际失效，先在当前任务记录原status、verification_result及证据引用，再将失效任务和受影响的已完成依赖任务同步退回false；原work_records和历史验收报告保持不变，避免true依赖false的无效状态。",
    "回修是为恢复已承诺前置条件的受控操作，不是越过依赖推进后续目标。受影响任务按依赖完成重验；恢复true时追加指向当前任务回修证据的记录，并填写新的verification_result，旧判定已在追加记录中保留。",
    "旧门禁报告保留为原版本证据；新版本只有在相应重验通过并产出新门禁记录后才能放行。失效的模型、数据锁和结果明确标记用途，不能直接用于新版本最终结论。"
  ],
  "protected_boundaries": [
    "v2控制器及其权重、资产、PD、功率模型、足迹、α/δ和旧数据锁维持冻结；不因回修自动替换、重训或重校准。",
    "RC-PPO/、HiRA/继续只读；旧校准源码确需改动仍先保留原快照并询问用户。",
    "manuscripts/**、tex/bib、投稿源文件与PDF等禁止写入，回修不得突破论文保护规则。",
    "执行主机、tmux、数据隔离、全部失败保留、资源上限及Git提交/推送授权规则继续适用。"
  ],
  "closure_rule": "所有回修均有完整历史引用、修复及重验依据；受影响任务/门禁已恢复有效，或明确保持受阻。未解除的问题留在当前任务remaining_work/blockers内，不作无条件最终交付。",
  "plan_revision_boundary": "2026-11-12仅修订未来要求；NAV-061执行时为每项审查问题登记前置任务、旧版本、受影响门禁及重验入口。确证原验收失效后仍按task_and_gate_state_rules回退依赖状态并重验，不在本次无运行证据的文档修订中伪造新判定。"
}
