{
  "latex-workshop.latex.tools": [
    {
      "name": "xelatexmk_local",
      "command": "D:/app/latex/texlive/2026/bin/windows/latexmk.exe",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-xelatex",
        "-outdir=%OUTDIR%",
        "-auxdir=%AUXDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "pdflatexmk_local",
      "command": "D:/app/latex/texlive/2026/bin/windows/latexmk.exe",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "-auxdir=%AUXDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (xelatex)",
      "tools": [
        "xelatexmk_local"
      ]
    },
    {
      "name": "latexmk (pdflatex)",
      "tools": [
        "pdflatexmk_local"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk (pdflatex)",
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/output/0914",
  "latex-workshop.message.error.show": true,
  "latex-workshop.message.warning.show": true
}
