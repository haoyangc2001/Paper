# CaMRA locomotion — machine-specific path defaults.
#
# Values below are the ones of the machine that produced the delivered
# controller (host 192.168.20.12, user caohy). Every variable can be overridden
# by exporting it before calling scripts/repro/*.sh or
# scripts/check_repro_readiness.py; an exported value always wins over this file.
#
# Nothing secret belongs here: these are filesystem paths only.
# Verify a machine with:  python scripts/check_repro_readiness.py

CAMRA_PYTHON=/pub/data/caohy/miniconda/envs/env_isaaclab/bin/python
CAMRA_LOG_ROOT=/pub/data/caohy/logs/camra
CAMRA_RSL_LOG_ROOT=/pub/data/caohy/logs/rsl_rl
CAMRA_RUN_ROOT=/pub/data/caohy/run/camra_go2
CAMRA_ASSET_ROOT=/pub/data/caohy/unitree_model
CAMRA_BUNDLE_ROOT=/pub/data/caohy/camra_bundles
CAMRA_XDG_DATA=/pub/data/caohy/xdgdata
CAMRA_XDG_CACHE=/pub/data/caohy/xdgcache
CAMRA_TMPDIR=/pub/data/caohy/tmp
CAMRA_DEVICE=cuda:0
CAMRA_TMUX_SESSION=camra-locomotion
