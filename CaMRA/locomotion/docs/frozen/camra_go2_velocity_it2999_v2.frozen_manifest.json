  "execution_spec": {
    "inference_mode": "no_grad",
    "inference_mode_note": "部署与闭环验证都在 torch.no_grad() 下运行。不使用 torch.inference_mode()：该模式会把仿真器在 step()/auto-reset 中写入的缓冲变成 inference tensor，导致下一次场景复位时的 in-place 写入被拒（TASK-026 attempt1 实测崩溃）。两侧都关闭 autograd，推理数值与计时口径不受影响。",
    "normalizer": {
      "empirical_normalization": false,
      "state_in_graph": false,
      "note": "训练期无经验归一化，导出图内不含 running statistics，因此不存在需要随包携带或更新的归一化状态；任何启用归一化的后续版本必须在清单中记录其状态并重新验证。"
    },
    "reset_semantics": {
      "wrapper": "ExternalCommandWrapper(on_reset=\"zero\")",
      "command_on_reset": "复位后命令被置零，随后由 10 Hz 零阶保持程序写入程序指令",
      "observation_quirk": "reset() 返回的观测是在内部 env 计算完成后、wrapper 写入程序指令之前算出的，因此该一拍观测携带的是复位时采样的随机指令；自下一拍起观测与施加指令一致（TASK-026 逐周期验证，前 3 维与 base_ang_vel*0.2 误差恒为 0）。部署端若自行复位，必须复现同一顺序，否则首拍观测会与训练分布不一致。",
      "episode_length_s": 20.0,
      "reward_or_curriculum_state": "不随包携带：推理不需要，且携带会诱导错误的状态恢复。"
    },
    "determinism": {
      "seed_used_in_verification": 100,
      "policy_eval_deterministic": true,
      "rollout_reproducible": "同一后端、同一种子在全新进程中逐位可复现（TASK-026 attempt4 与最终轮的对象逐位相同）；JIT 与训练器臂在闭环中逐位一致；ONNX 因 float32 算子顺序在 7~45 个控制周期后离开噪声地板，区间统计量仍一致到 1e-3 以内。"
    }
