# HiRA 本机路径配置样例（HIRA-006）
#
# 用法：`set -a; . config/hira.env; set +a`，或逐项 export。
# 原则：换机器只改本文件，不改任何源码；v2 的位置一律只读，不复用其日志根。
# 注意：本文件是「某台机器」的配置样例，源码里不得硬编码这些绝对路径。

# ---- 解释器与设备 ----
CAMRA_HIRA_PYTHON=/pub/data/caohy/miniconda/envs/env_isaaclab/bin/python
# cuda:0 是「进程可见的第 0 块卡」，实际物理卡由 CUDA_VISIBLE_DEVICES 决定。
# 本机 GPU0/GPU1 被他人占用，运行时统一 CUDA_VISIBLE_DEVICES=2。
CAMRA_HIRA_DEVICE=cuda:0
CAMRA_HIRA_VISIBLE_DEVICES=2

# ---- HiRA 自己的可写位置（与 v2 隔离）----
CAMRA_HIRA_DATA_ROOT=/pub/data/caohy/logs/camra_hira
CAMRA_HIRA_BUNDLE_ROOT=/pub/data/caohy/camra_hira_bundles
CAMRA_HIRA_EXPERIMENT_ROOT=/home/caohy/repositories/Paper/CaMRA/calibration/experiments/hira_go2_18500
CAMRA_HIRA_TMUX_SESSION=camra-hira-calibration

# ---- 只读来源与旧证据 ----
CAMRA_HIRA_SOURCE_ROOT=/home/caohy/repositories/Paper/HiRA
CAMRA_HIRA_CHECKPOINT=/home/caohy/repositories/Paper/HiRA/logs/rough_go2/Sep08_11-57-26_/model_18500.pt
CAMRA_HIRA_URDF=/home/caohy/repositories/Paper/HiRA/legged_gym_go2/resources/robots/go2/urdf/go2.urdf
CAMRA_HIRA_ASSET_ROOT=/pub/data/caohy/unitree_model
CAMRA_V2_READONLY_LOG_ROOT=/pub/data/caohy/logs/camra
CAMRA_V2_READONLY_BUNDLE_ROOT=/pub/data/caohy/camra_bundles
CAMRA_V2_FROZEN_BUNDLE=/pub/data/caohy/camra_bundles/frozen/camra_go2_velocity_it2999_v2

# ---- Isaac 运行期（headless 必需，避免写 NFS 家目录）----
OMNI_KIT_ACCEPT_EULA=YES
HOME=/pub/data/caohy/fakehome
PYTHONDONTWRITEBYTECODE=1
TMPDIR=/pub/data/caohy/tmp
XDG_DATA_HOME=/pub/data/caohy/xdgdata
XDG_CACHE_HOME=/pub/data/caohy/xdgcache
XDG_CONFIG_HOME=/pub/data/caohy/xdgconfig
